rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A family's games can only be reached by a device that knows its 12-character family code.
    // Nobody can list the families, so codes can't be discovered.
    match /families/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.size() == 12;
      match /{rest=**} {
        allow read, write: if request.auth != null;
      }
    }
    // Linked games: anyone with the 6-number code can join that one game.
    match /games/{code} {
      allow get, create, update: if request.auth != null && code.size() == 6;
      // The host can delete a finished game; anyone can delete one that has sat idle for 12 hours.
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid
                    || resource.data.ended == true || resource.data.t < request.time.toMillis() - 43200000);
      match /p/{player} {
        allow read, write: if request.auth != null;
      }
      match /i/{item} {
        allow read, write: if request.auth != null;
      }
      // Each player can be claimed by one device only. Only that device (or the host) can change or free it.
      match /seats/{player} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
                      || get(/databases/$(database)/documents/games/$(code)).data.hostUid == request.auth.uid
                      || get(/databases/$(database)/documents/games/$(code)).data.ended == true
                      || get(/databases/$(database)/documents/games/$(code)).data.t < request.time.toMillis() - 43200000);
      }
    }
    // Everything else is closed.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
