rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A family's games can only be reached by a device that knows its 12-character family code.
    // Nobody can list the families, so codes can't be discovered.
    match /families/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.size() == 12;
      match /{rest=**} {
        allow read, write: if request.auth != null;
      }
    }
    // Linked games: anyone with the 6-number code can join that one game.
    match /games/{code} {
      allow get, create, update: if request.auth != null && code.size() == 6;
      match /p/{player} {
        allow read, write: if request.auth != null;
      }
    }
    // Everything else is closed.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
